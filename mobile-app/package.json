{
  "name": "bookedradar-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.28",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --import tsx --test tests/domain.test.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:screens",
    "export:ios": "expo export --platform ios --output-dir build/ios",
    "export:android": "expo export --platform android --output-dir build/android",
    "export:web": "expo export --platform web --output-dir build/web",
    "test:browser": "playwright test",
    "test:screens": "jest --runInBand"
  },
  "private": true
}
